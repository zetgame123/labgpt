# Получить бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Модель для ответов (openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# Модель распознавания речи (Whisper на Groq — очень быстро и бесплатно)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Сколько последних секунд системного звука держать в кольцевом буфере
AUDIO_BUFFER_SECONDS=40

# Использовать веб-поиск через groq/compound-mini (1 = вкл, 0 = выкл)
USE_WEB_SEARCH=0

# Контекст / роль кандидата (можно поменять под свою вакансию)
USER_ROLE=Software Engineer
