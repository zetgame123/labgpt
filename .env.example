# Активный провайдер: groq (бесплатно и быстро) или openai (большие проекты + чтение экрана)
AI_PROVIDER=groq

# --- Groq API (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- OpenAI API (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=whisper-1
# Опционально: кастомный OpenAI-совместимый Base URL (прокси / OpenRouter и т.д.)
OPENAI_BASE_URL=

# Сколько последних секунд системного звука держать в кольцевом буфере
AUDIO_BUFFER_SECONDS=40

# Использовать веб-поиск для Groq gpt-oss (1 = вкл, 0 = выкл)
USE_WEB_SEARCH=0

# Контекст / роль кандидата (можно поменять под свою вакансию)
USER_ROLE=Software Engineer

# Фоновая живая расшифровка последних 5 минут диалога (1 = вкл, 0 = выкл)
LIVE_TRANSCRIPT=1

# Стиль ответов: brief (тезисно) или detailed (подробно + код)
ANSWER_STYLE=brief

# Режим захвата экрана: monitor (весь монитор) или active_window (только активное окно)
SCREEN_CAPTURE_MODE=monitor

# Глобальные горячие клавиши (можно переназначить прямо в настройках)
HOTKEY_ANSWER=Ctrl+Shift+Space
HOTKEY_SCREEN=Ctrl+Shift+S
HOTKEY_TOGGLE=Ctrl+Shift+H
HOTKEY_CLEAR=Ctrl+Shift+C
HOTKEY_CLICK_THROUGH=Ctrl+Shift+T
